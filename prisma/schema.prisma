// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Khusus untuk Supabase
}

model Family {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id         String        @db.Uuid // Relasi ke auth.users Supabase
  phone            String?       @db.VarChar(30)
  has_password     Boolean       @default(false)
  password_hash    String?       @db.VarChar(255)
  alias            String        @db.VarChar(100)
  wilayah          String        @db.VarChar(100)
  budget_belanja   Decimal       @default(3000000) @db.Decimal(12, 2)
  tipe_budget      String        @default("bulanan") @db.VarChar(20) // 'bulanan' | 'mingguan'
  budget_harian_rp Decimal?      @default(75000) @db.Decimal(12, 2)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  
  members          Member[]
  warungs          Warung[]
  transactions     Transaction[]
  meal_plans       MealPlan[]

  @@map("families")
}

model Member {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id        String   @db.Uuid
  alias            String   @db.VarChar(100)
  usia_tahun       Int
  jenis_kelamin    String   @db.VarChar(20)
  status_khusus    String?  @db.VarChar(100) // Boleh null jika tidak ada
  alergen          String[] // Array teks untuk multiple alergi
  
  family           Family   @relation(fields: [family_id], references: [id], onDelete: Cascade)

  @@map("members")
}

model Warung {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id        String?       @db.Uuid
  nama_warung      String        @db.VarChar(150)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  
  family           Family?       @relation(fields: [family_id], references: [id], onDelete: Cascade)
  harga_warung     HargaWarung[]
  transactions     Transaction[]

  @@map("warungs")
}

model HargaWarung {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warung_id          String   @db.Uuid
  kode_tkpi          String   @db.VarChar(50)
  harga_per_100g_rp  Decimal  @db.Decimal(10, 2)
  tanggal_update     DateTime @default(now()) @db.Date
  
  warung             Warung   @relation(fields: [warung_id], references: [id], onDelete: Cascade)
  bahan              Bahan    @relation(fields: [kode_tkpi], references: [kode_tkpi], onDelete: Restrict)

  @@unique([warung_id, kode_tkpi])
  @@map("harga_warung")
}

model Transaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id        String   @db.Uuid
  warung_id        String?  @db.Uuid // Null jika pengeluaran di luar warung terdaftar
  jenis            String   @db.VarChar(20) // "PEMASUKAN" atau "PENGELUARAN"
  nominal          Decimal  @db.Decimal(12, 2)
  catatan          String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  
  family           Family   @relation(fields: [family_id], references: [id], onDelete: Cascade)
  warung           Warung?  @relation(fields: [warung_id], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model MealPlan {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id        String   @db.Uuid
  hasil_json       Json     // Menyimpan struktur jadwal 7 hari & porsi
  total_biaya      Decimal  @db.Decimal(12, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  
  family           Family   @relation(fields: [family_id], references: [id], onDelete: Cascade)

  @@map("meal_plans")
}

model Bahan {
  kode_tkpi        String        @id @db.VarChar(50)
  nama_bahan       String        @db.VarChar(150)
  kategori         String        @db.VarChar(100)
  kategori_menu    String?       @db.VarChar(50)
  kondisi          String?       @db.VarChar(50)
  energi_kcal      Float
  protein_g        Float?
  lemak_g          Float?
  karbohidrat_g    Float?
  kalsium_mg       Float?
  zat_besi_mg      Float?
  seng_mg          Float?
  vitamin_a_mcg    Float?
  bdd_percent      Float
  alergen          String[]      @default([])
  
  harga_warung     HargaWarung[]
  resep_bahan      ResepBahan[]

  @@map("bahan")
}

model Resep {
  kode_resep            String          @id @db.VarChar(50)
  nama_resep            String          @db.VarChar(150)
  kategori              String          @db.VarChar(100)
  porsi                 String          @db.VarChar(50)
  keterangan            String?         @db.Text
  catatan_keamanan      String?         @db.Text
  target_usia_max_tahun Int?
  
  resep_bahan           ResepBahan[]
  paket_komponen        PaketKomponen[]

  @@map("resep")
}

model ResepBahan {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_resep       String   @db.VarChar(50)
  kode_tkpi        String   @db.VarChar(50)
  jumlah_gram      Float
  
  resep            Resep    @relation(fields: [kode_resep], references: [kode_resep], onDelete: Cascade)
  bahan            Bahan    @relation(fields: [kode_tkpi], references: [kode_tkpi], onDelete: Restrict)

  @@map("resep_bahan")
}

model Akg {
  kode_kelompok        String   @id @db.VarChar(50)
  kelompok_usia        String   @db.VarChar(50)
  jenis_kelamin        String   @db.VarChar(20)
  tipe                 String?  @db.VarChar(50)
  umur_min_bulan       Int?
  umur_max_bulan       Int?
  dalam_cakupan_produk String?  @db.VarChar(20)
  energi_kcal          Float
  protein_g            Float?
  vitamin_a_mcg_re     Float?
  kalsium_mg           Float?
  zat_besi_mg          Float?
  seng_mg              Float?
  catatan              String?  @db.Text

  @@map("akg")
}

model PaketMenu {
  kode_paket       String          @id @db.VarChar(50)
  nama_paket       String          @db.VarChar(150)
  keterangan       String?         @db.Text
  catatan_keamanan String?         @db.Text
  
  komponen         PaketKomponen[]

  @@map("paket_menu")
}

model PaketKomponen {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_paket String    @db.VarChar(50)
  kode_resep String    @db.VarChar(50)

  paket      PaketMenu @relation(fields: [kode_paket], references: [kode_paket], onDelete: Cascade)
  resep      Resep     @relation(fields: [kode_resep], references: [kode_resep], onDelete: Cascade)

  @@map("paket_komponen")
}

model OtpVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String   @db.VarChar(25)
  code       String   @db.VarChar(10)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([phone])
  @@map("otp_verifications")
}
